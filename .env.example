# Local Hugging Face Diffusers inference (no paid API keys)
VLC_PORT=8000
# Public model on Hugging Face, CreativeML OpenRAIL-M license:
VLC_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
# Optional. CPU diffusion is extremely slow: set to 1 only for experiments.
VLC_ALLOW_CPU=0

# Optional street-level imagery discovery. This is an imagery API token,
# NOT a paid image-generation token. Store on the server, not in public JS.
# Supported in Node/Vercel server; Python GPU server uses Commons fallback.
MAPILLARY_ACCESS_TOKEN=
